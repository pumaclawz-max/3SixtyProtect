# ─────────────────────────────────────────────────────────────
# 3Sixty Protect — Environment variables
# Copy this file to `.env.local` and fill in real values.
# The public site renders with built-in demo data until these
# Supabase values are set, so you can develop the UI immediately.
# ─────────────────────────────────────────────────────────────

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
# Public client key: the new publishable key (preferred) or the legacy anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server key — server only, NEVER expose to the browser.
# Used for admin writes / bypassing RLS in server actions.
# The new secret key (preferred) or the legacy service-role key.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (optional, for when online payment is switched on)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Activity log (optional): salt for the cookieless visitor hash.
# Falls back to the Supabase server key when unset.
ACTIVITY_SALT=

# Email alerts for new enquiries/bookings (optional)
# Add Resend from the Vercel Marketplace; it sets RESEND_API_KEY on the project.
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. 3Sixty Protect <notifications@3sixtyprotect.com>
EMAIL_FROM=
# Inbox(es) that receive alerts, comma-separated (defaults to info@3sixtyprotect.com)
CONTACT_NOTIFICATION_EMAIL=
